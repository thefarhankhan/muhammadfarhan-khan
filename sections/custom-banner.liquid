<section class="custom-banner">
  <div class="banner-header">
    <h3>
      {{ section.settings.header }}
    </h3>

    <p class="banner-text">
      {{ section.settings.header_subtext }}
    </p>

    <a href="{{ section.settings.header_button_link }}" class="btn-primary">
      {{ section.settings.header_button_text }}
    </a>
  </div>

  <div>
    <img src="{{ 'banner/hero-image.png' | asset_url }}" width="100%" height="100%" alt="Hero banner">
  </div>

  <div class="banner-inner">
    <h1 class="banner-title">
      {{ section.settings.heading }}
    </h1>

    <p class="banner-text">
      {{ section.settings.subtext }}
    </p>

    <a href="{{ section.settings.button_link }}" class="btn-primary">
      {{ section.settings.button_text }}
    </a>
  </div>

  <div>
    <p class="banner-text">
      {{ section.settings.footer_subtext }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "header",
      "label": "Header Text",
      "default": "Tisso Vison"
    },
    {
      "type": "textarea",
      "id": "header_subtext",
      "label": "Header Subtext",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "header_button_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "header_button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "textarea",
      "id": "footer_subtext",
      "label": "Subtext",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
