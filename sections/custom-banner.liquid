<section class="custom-banner">

  <div class="banner-header">
    <h3 class="banner-title">
      {{ section.settings.heading }}
    </h3>

    <p class="banner-text">
      {{ section.settings.subtext }}
    </p>

    <a href="{{ section.settings.button_link }}" class="btn-primary">
      {{ section.settings.button_text }}
    </a>
  </div>
  
  <div class="banner-inner">

    <h1 class="banner-title">
      {{ section.settings.heading }}
    </h1>

    <p class="banner-text">
      {{ section.settings.subtext }}
    </p>

    <a href="{{ section.settings.button_link }}" class="btn-primary">
      {{ section.settings.button_text }}
    </a>

  </div>
  <div>
    <p class="banner-text">
      {{ section.settings.subtext }}
    </p>
  </div>

</section>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Welcome to Our Store"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover our best products"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
